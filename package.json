{
   "name": "nuxt-ssr-oss",
   "type": "module",
   "private": true,
   "description": "Server-rendered CSV data profiling app (Nuxt 4 SSR + nodejs-polars + Bun)",
   "scripts": {
     "dev": "nuxi dev",
     "build": "nuxi build",
