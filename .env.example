# Copy to .env and adjust as needed. All values have sensible defaults in
# nuxt.config.ts `runtimeConfig`; these override them.

# Per-job working area on disk (holds data.csv + report.json)
TMP_DIR=./.tmp

# Max accepted upload size in bytes (default 200 MB)
# MAX_UPLOAD_BYTES=209715200

# Heavy stats computed over at most this many rows (default 100000)
# SAMPLE_ROWS=100000

# Leading rows shown in the sample table (default 25)
# PREVIEW_ROWS=25

# Bins per numeric histogram (default 30)
# HISTOGRAM_BINS=30

# Top-N most frequent values per column (default 10)
# TOP_VALUES=10

# Max concurrent Polars profiling jobs (default 2)
# PROFILE_CONCURRENCY=2

# Wall-clock timeout per profile build in ms (default 300000)
# PROFILE_TIMEOUT_MS=300000

# Evict job dirs / cache entries after this many ms (default 1800000)
# JOB_TTL_MS=1800000
